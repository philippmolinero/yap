<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Yap Phone</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_yap._tcp</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Yap Phone finds your Mac on the local network to send dictation audio.</string>
